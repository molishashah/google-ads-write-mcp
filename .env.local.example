# Base URL of your deployment (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Layer 1: Google Ads API access (service-account identity)
#
# All Ads API calls are made with one Google Cloud service account. Add the
# service-account email as a user on the Google Ads manager/customer account
# with the access level your tools need.
#
# Local dev: set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
# Vercel/serverless: set GOOGLE_APPLICATION_CREDENTIALS_JSON to the JSON content.
# ─────────────────────────────────────────────────────────────

# Developer token from your Google Ads manager account
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token

GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Manager (MCC) account ID, no hyphens.
# Required when operating customer accounts under an MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# ─────────────────────────────────────────────────────────────
# Layer 2: Google OAuth client for MCP team-member identity
#
# Runtime sign-in verifies team-member identity only. Ads API calls still use
# the service-account identity above.
#
# Required scopes on the OAuth consent screen:
#   - openid email profile
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# ─────────────────────────────────────────────────────────────
# Layer 2: JWT signing for the MCP auth handshake
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-random-secret-here

# Optional: restrict sign-in to a specific Google Workspace domain
ALLOWED_DOMAIN=yourcompany.com
