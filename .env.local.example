# Base URL of your deployment (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Layer 1: Google Ads API access (single shared identity)
#
# All Ads API calls are made with ONE refresh token scoped to
# https://www.googleapis.com/auth/adwords. Mint it once against
# a manager-account user, then store here.
#
# How to mint: https://developers.google.com/google-ads/api/docs/oauth/cloud-project
# Quick start: use google-ads-api's `oauth2.generate_user_credentials`
# helper or Google OAuth Playground with the Ads client_id/secret.
# ─────────────────────────────────────────────────────────────

# Developer token from your Google Ads manager account
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token

# Shared refresh token (scope: adwords). Never expires unless
# manually revoked.
GOOGLE_ADS_REFRESH_TOKEN=1//0g...

# Manager (MCC) account ID, no hyphens.
# Required when operating customer accounts under an MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# ─────────────────────────────────────────────────────────────
# Layer 1 + Layer 2: Google OAuth client (reused for both)
#
# The same OAuth 2.0 client is used for two things:
#  1. (one-time) Minting GOOGLE_ADS_REFRESH_TOKEN above.
#  2. (runtime) Verifying team-member identity — each user
#     signs in with Google, we store only their email in a
#     short-lived JWT, and all Ads API calls use the single
#     shared refresh token regardless of who's calling.
#
# Required scopes on the OAuth consent screen:
#   - openid email profile            (for team-member identity)
#   - https://www.googleapis.com/auth/adwords  (for refresh-token minting)
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# ─────────────────────────────────────────────────────────────
# Layer 2: JWT signing for the MCP auth handshake
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-random-secret-here

# Optional: restrict sign-in to a specific Google Workspace domain
ALLOWED_DOMAIN=yourcompany.com
